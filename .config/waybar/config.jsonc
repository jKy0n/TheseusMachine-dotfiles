[
  {
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "module-margin": "2",
    //  --------------------  Modules  --------------------
    "modules-left": [
      "niri/workspaces"
      // "niri/window"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "cpu",
      "temperature",
      "memory",
      "pulseaudio",
      "tray",
      "custom/power"
    ],
    //  --------------------  Left Bar  --------------------
    "niri/workspaces": {},
    // "niri/window": {
    //   "max-length": 120
    // },
    //  --------------------  Center Bar  --------------------
    "clock": {
      "format": "{:%A, %d %B %Y - %R}",
      "tooltip-format": "<tt><span size='12000'>{calendar}</span></tt>",
      "calendar": {
        "mode": "year",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "first-day-of-week": 1,
        "on-scroll": 1,
        "on-click-right": "mode",
        "format": {
          "months": "<span color='#8caaee'><b>{}</b></span>",
          "days": "<span color='#c6d0f5'><b>{}</b></span>",
          "today": "<span color='#e78284'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode",
        "on-click-forward": "tz_up",
        "on-click-backward": "tz_down",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    },
    //  --------------------  Right Bar  --------------------
    "cpu": {
      "format": " <span size='16336' baseline_shift='-3pt'> </span>{usage}% | {avg_frequency} GHz "
    },
    "temperature": {
      "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
      "format": " <span size='11336' baseline_shift='-2pt'> </span> {temperatureC}°C "
    },
    "memory": {
      "format": "<span size='16336' baseline_shift='-2pt'> </span>{}% "
    },
    "pulseaudio": {
      "format": " <span size='16336' baseline_shift='-2pt'> </span>{volume}% ",
      "scroll-step": 1,
      "on-click": "pwvucontrol"
    },
    "tray": {
      "spacing": 8
    },
    "custom/power": {
      "format": "<span size='14336'>⏻</span>",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/power_menu.xml",
      "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend"
      }
    }
  },
  // --------------------  Waybar tela 1  --------------------
  {
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "module-margin": 2,
    //  --------------------  Left Modules  --------------------
    "modules-left": [
      "niri/workspaces"
    ],
    "niri/workspaces": {},
    //  --------------------  Right Modules  --------------------
    "modules-right": [
      "cpu",
      "memory",
      "pulseaudio",
      "clock",
      "custom/power"
    ],
    "cpu": {
      "format": " <span size='16336' baseline_shift='-3pt'> </span>{usage}% "
    },
    "memory": {
      "format": "<span size='16336' baseline_shift='-2pt'> </span>{}% "
    },
    "pulseaudio": {
      "format": " <span size='16336' baseline_shift='-2pt'> </span>{volume}% ",
      "scroll-step": 1,
      "on-click": "pwvucontrol"
    },
    "clock": {
      "format": "{:%R}"
    },
    "custom/power": {
      "format": "<span size='14336'>⏻</span>",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/power_menu.xml",
      "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend"
      }
    }
  },
  // --------------------  Waybar tela 2  --------------------
  {
    "output": "HDMI-A-2",
    "layer": "top",
    "position": "right",
    "module-margin": 2,
    //  --------------------  Top Modules  --------------------
    "modules-left": [
      "niri/workspaces"
    ],
    "niri/workspaces": {},
    //  --------------------  Bottom Modules  --------------------
    "modules-right": [
      "cpu",
      "memory",
      "pulseaudio",
      "clock",
      "custom/power"
    ],
    "cpu": {
      "format": " <span size='16336' baseline_shift='-3pt'> </span>{usage}% "
    },
    "memory": {
      "format": "<span size='16336' baseline_shift='-2pt'> </span>{}% "
    },
    "pulseaudio": {
      "format": " <span size='16336' baseline_shift='-2pt'> </span>{volume}% ",
      "scroll-step": 1,
      "on-click": "pwvucontrol"
    },
    "clock": {
      "format": "{:%R}"
    },
    "custom/power": {
      "format": "<span size='14336'>⏻</span>",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/power_menu.xml",
      "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend"
      }
    }
  }
]