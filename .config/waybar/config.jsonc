[
  // ---------------------------------------------------------
  // ----------------  Waybar tela Principal  ----------------
  // ---------------------------------------------------------
  {
    "output": "DP-1",
    "name": "bar-dp1",
    "layer": "top",
    "position": "top",
    "module-margin": "2",
    //  --------------------  Modules  --------------------
    "modules-left": [
      "image#niri-logo",
      "niri/workspaces"
      // "niri/window"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "group/sysinfo",
      "memory",
      "pulseaudio",
      "tray",
      "custom/mako-dnd",
      "custom/ephedrine",
      "custom/power"
    ],
    //  --------------------  Left Bar  --------------------
    "image#niri-logo": {
      "path": "/home/jkyon/Pictures/icons/niri/niri-logo.svg",
      "size": 25,
      "tooltip": false
    },
    "niri/workspaces": {},
    // "niri/window": {
    //   "max-length": 120
    // },
    //  --------------------  Center Bar  ------------------
    "clock": {
      "format": "{:%A, %d %B %Y - %R}",
      "tooltip-format": "<tt><span size='10000'>{calendar}</span></tt>",
      "calendar": {
        "mode": "year",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "first-day-of-week": 1,
        "on-scroll": 1,
        "on-click-right": "mode",
        "format": {
          "months": "<span color='#8caaee'><b>{}</b></span>",
          "days": "<span color='#c6d0f5'><b>{}</b></span>",
          "today": "<span color='#e78284'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode",
        "on-click-forward": "tz_up",
        "on-click-backward": "tz_down",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    },
    //  --------------------  Right Bar  --------------------
    "group/sysinfo": {
      "orientation": "horizontal",
      "modules": ["cpu", "temperature"]
    },
    "cpu": {
      "format": " {usage}% | {avg_frequency} GHz |"
    },
    "temperature": {
      "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
      "format": " {temperatureC}°C"
    },
    "memory": {
      "format": "  {}%"
    },
    "pulseaudio": {
      "format": "  {volume}%",
      "scroll-step": 1,
      "on-click": "pwvucontrol"
    },
    "tray": {
      "spacing": 8
    },
    "custom/mako-dnd": {
      "exec": "~/.config/waybar/scripts/mako-dnd.sh",
      "on-click": "makoctl mode -t dnd && pkill -RTMIN+8 waybar",
      "return-type": "json",
      "interval": "once",
      "signal": 8
    },
    "custom/ephedrine": {
      "exec": "~/.config/waybar/scripts/ephedrine.sh",
      "on-click": "ephedrine toggle && pkill -RTMIN+9 waybar",
      "return-type": "json",
      "interval": 10,
      "signal": 9
    },
    "custom/power": {
      "format": "⏻",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/power_menu.xml",
      "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend"
      }
    }
  },
  // ---------------------------------------------------------
  // --------------------  Waybar tela 1  --------------------
  // ---------------------------------------------------------
  {
    "output": "HDMI-A-1",
    "name": "bar-hdmi1",
    "layer": "top",
    "position": "top",
    "module-margin": 2,
    //  --------------------  Left Modules  --------------------
    "modules-left": [
      "niri/workspaces"
    ],
    "modules-center": [
      "clock"
    ],
    "niri/workspaces": {},
    //  --------------------  Right Modules  --------------------
    "modules-right": [
      "cpu",
      "memory",
      "pulseaudio",
      "custom/power"
    ],
    "cpu": {
      "format": " <span size='16336' baseline_shift='-3pt'> </span>{usage}% "
    },
    "memory": {
      "format": "<span size='16336' baseline_shift='-2pt'> </span>{}% "
    },
    "pulseaudio": {
      "format": " <span size='16336' baseline_shift='-2pt'> </span>{volume}% ",
      "scroll-step": 1,
      "on-click": "pwvucontrol"
    },
    "clock": {
      "format": "{:%A, %d %B %Y - %R}"
    },
    "custom/power": {
      "format": "<span size='14336'>⏻</span>",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/power_menu.xml",
      "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend"
      }
    }
  },
  // ---------------------------------------------------------
  // --------------------  Waybar tela 2  --------------------
  // ---------------------------------------------------------
  {
    "output": "HDMI-A-2",
    "name": "bar-hdmi2",
    "layer": "top",
    "position": "right",
    "max-width": 1,
    "module-margin": 1,
    //  --------------------  Top Modules  --------------------
    "modules-left": [
      "clock",
      "niri/workspaces"
    ],
    "niri/workspaces": {},
    //  --------------------  Bottom Modules  --------------------
    "modules-right": [
      "cpu",
      "memory",
      "pulseaudio",
      "custom/power"
    ],
    "cpu": {
      "format": " <span size='16336' baseline_shift='-3pt'> </span>{usage}% "
    },
    "memory": {
      "format": "<span size='16336' baseline_shift='-2pt'> </span>{}% "
    },
    "pulseaudio": {
      "format": " <span size='16336' baseline_shift='-2pt'> </span>{volume}% ",
      "scroll-step": 1,
      "on-click": "pwvucontrol"
    },
    "clock": {
      "format": "{:%R}"
    },
    "custom/power": {
      "format": "<span size='14336'>⏻</span>",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/power_menu.xml",
      "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend"
      }
    }
  }
]