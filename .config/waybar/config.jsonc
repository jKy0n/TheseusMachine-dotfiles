[
  {
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 16,
    "modules-left": [
      "niri/workspaces",
      "niri/window"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "cpu",
      "temperature",
      "memory",
      "pulseaudio",
      "tray",
      "custom/power"
    ],
    "niri/workspaces": {},
    "niri/window": {
      "max-length": 60
    },
    "tray": {
      "spacing": 8
    },
    "pulseaudio": {
      "format": " {volume}% ",
      "scroll-step": 1,
      "on-click": "pwvucontrol"
    },
    "cpu": {
      "format": "{usage}% | {avg_frequency}GHz"
    },
    "temperature": {
      "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
      "format": " {temperatureC}°C "
    },
    "memory": {
      "format": " {}% "
    },
    "clock": {
      "format": "{:%A, %d %B %Y - %R}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "year",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "first-day-of-week": 1,
        "on-scroll": 1,
        "on-click-right": "mode",
        "format": {
          "months": "<span color='#8caaee'><b>{}</b></span>",
          "days": "<span color='#c6d0f5'><b>{}</b></span>",
          "today": "<span color='#e78284'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode",
        "on-click-forward": "tz_up",
        "on-click-backward": "tz_down",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    },
    "custom/power": {
      "format": "⏻ ",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/power_menu.xml",
      "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        // "hibernate": "systemctl hibernate",
        "suspend": "systemctl suspend"
      }
    }
  }
